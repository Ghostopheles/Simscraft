<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

    <Include file="ManagerListEntry.lua"/>

	<Frame name="SimscraftShoppingListManagerListEntryTemplate" mixin="SimscraftShoppingListManagerListEntryMixin" virtual="true">
		<Size y="60"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="house-upgrade-reward-large-tile-bg" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="NameText" font="GameFontWhite" justifyH="LEFT" maxLines="1">
					<Anchors>
						<Anchor point="LEFT" x="10"/>
					</Anchors>
				</FontString>

				<FontString parentKey="SizeText" font="GameFontWhite" justifyH="RIGHT" maxLines="1">
					<Anchors>
						<Anchor point="RIGHT" x="-55" y="7"/>
					</Anchors>
				</FontString>

				<FontString parentKey="DateText" font="GameFontWhite" justifyH="RIGHT" maxLines="1" text="CHINA">
					<Anchors>
						<Anchor point="RIGHT" x="-55" y="-7"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Highlight" atlas="housing-basic-panel-gradient-header-bg">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT" y="3"/>
					</Anchors>
				</Texture>
				<Texture parentKey="HighlightBorder" atlas="TalkingHeads-Glow-TextSheen" setAllPoints="true" alpha="0.15"/>
			</Layer>
		</Layers>

		<Frames>
			<Button parentKey="DeleteButton" inherits="UIButtonTemplate">
				<Size x="25" y="25"/>
				<Anchors>
					<Anchor point="RIGHT" x="-20"/>
				</Anchors>
				<KeyValues>
					<KeyValue key="buttonArtKit" value="128-RedButton-Delete" type="string" />
					<KeyValue key="tooltipText" value="DELETE" type="global"/>
					<KeyValue key="tooltipTextColor" value="HIGHLIGHT_FONT_COLOR" type="global"/>
					<KeyValue key="tooltipAnchor" value="ANCHOR_TOP" type="string"/>
				</KeyValues>
			</Button>
		</Frames>

		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>

	</Frame>
</Ui>
