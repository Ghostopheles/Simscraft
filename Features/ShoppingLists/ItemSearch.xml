<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

	<Include file="ItemSearch.lua"/>

	<Frame name="SimscraftDecorItemSearchResultTemplate" mixin="SimscraftDecorItemSearchResultMixin" virtual="true">
		<Size y="75"/>
		<Frames>
			<Button parentKey="ItemButton" propagateMouseInput="Both">
				<Size x="50" y="50"/>
				<Anchors>
					<Anchor point="LEFT" x="20"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="Icon" setAllPoints="true"/>
					</Layer>
				</Layers>
			</Button>
			<Frame parentKey="SelectionHighlight" inherits="NineSlicePanelTemplate" hidden="true" setAllPoints="true"/>
		</Frames>

		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Highlight" atlas="housing-basic-panel-gradient-header-bg" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT" y="3"/>
					</Anchors>
				</Texture>
				<Texture parentKey="HighlightBorder" atlas="TalkingHeads-Glow-TextSheen" setAllPoints="true" alpha="0.15"/>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Name" font="GameFontWhite">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.ItemButton" relativePoint="RIGHT" x="10" />
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="TalkingHeads-TextBackground" setAllPoints="true"/>
				<Texture parentKey="FocusedBackground" atlas="TalkingHeads-Housing-TextBackground" setAllPoints="true" alpha="0"/>
			</Layer>
		</Layers>

		<Animations>
			<AnimationGroup parentKey="FadeIn" looping="NONE" setToFinalAlpha="true">
				<Alpha parentKey="Alpha" duration="0.25" fromAlpha="0" toAlpha="1" smoothing="IN_OUT"/>
			</AnimationGroup>
			<AnimationGroup parentKey="FadeOut" looping="NONE" setToFinalAlpha="true">
				<Alpha parentKey="Alpha" duration="0.35" fromAlpha="1" toAlpha="0" smoothing="OUT_IN"/>
			</AnimationGroup>
		</Animations>

        <Scripts>
            <OnLoad method="OnLoad"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnUpdate method="OnUpdate"/>
			<OnMouseUp method="OnMouseUp"/>
        </Scripts>
	</Frame>

	<Frame name="SimscraftDecorItemSearchTemplate" mixin="SimscraftDecorItemSearchMixin" virtual="true">
		<Frames>
			<EditBox parentKey="SearchBox" inherits="SearchBoxTemplate" font="GameFontWhite" autoFocus="false">
				<Size x="175" y="20"/>
				<Anchors>
					<Anchor point="TOP"/>
				</Anchors>
				<KeyValues>
					<KeyValue key="instructions" value="Search for a decor item by name" type="string" />
				</KeyValues>
			</EditBox>

			<Frame parentKey="SearchResults">
				<Anchors>
					<Anchor point="TOPLEFT" y="-25" />
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>

				<Frames>
					<Frame parentKey="ScrollBox" inherits="WowScrollBoxList"/>
					<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
						<Anchors>
							<Anchor point="TOPRIGHT" x="-10" y="-10"/>
							<Anchor point="BOTTOMRIGHT" x="-10" y="10"/>
						</Anchors>
					</EventFrame>
				</Frames>
			</Frame>
		</Frames>

		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>


	<Frame name="SimscraftItemSearchTest" parent="UIParent" inherits="SimscraftDecorItemSearchTemplate">
		<Size x="400" y="500"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
	</Frame>
</Ui>
