<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

    <Include file="ListDisplay.xml"/>
    <Include file="Manager.lua" />

    <Frame name="SimscraftShoppingListEntryTemplate" virtual="true" mixin="SimscraftShoppingListEntryTemplate">
        
    </Frame>

    <Frame name="SimscraftShoppingListManagerListFrameTemplate" virtual="true"
        mixin="SimscraftShoppingListManagerListFrameMixin">
        <Frames>
            <Frame parentKey="ScrollBox" inherits="WowScrollBoxList" />
            <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5" />
                    <Anchor point="BOTTOMRIGHT" x="-5" y="5" />
                </Anchors>
            </EventFrame>
            <Frame parentKey="TitleFrame">
                <Size y="22" />
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" x="-18" />
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="Title" inherits="GameFontHighlight" justifyV="MIDDLE"
                            justifyH="CENTER">
                            <Anchors>
                                <Anchor point="TOPLEFT" />
                                <Anchor point="BOTTOMRIGHT" />
                            </Anchors>
                        </FontString>
                        <Texture parentKey="TitleBackground" atlas="housing-basic-panel-footer">
                            <Anchors>
                                <Anchor point="TOPLEFT" />
                                <Anchor point="BOTTOMRIGHT" />
                            </Anchors>
                        </Texture>
                        <Texture parentKey="TitleDivider"
                            atlas="housing-bulletinboard-list-header-decorative-line">
                            <Size y="9" />
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.TitleBackground"
                                    relativePoint="BOTTOMLEFT" />
                                <Anchor point="RIGHT" relativeKey="$parent.TitleBackground"
                                    relativePoint="BOTTOMRIGHT" />
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true"
                    atlas="housefinder_neighborhood-list-bg" />
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="RightBorder" atlas="catalog-main-divider">
                    <Size x="34" />
                    <Anchors>
                        <Anchor point="TOP" relativePoint="TOPRIGHT" />
                        <Anchor point="BOTTOM" relativePoint="BOTTOMRIGHT" />
                    </Anchors>
                </Texture>
                <Texture parentKey="RightBorderBR" atlas="housing-dashboard-filigree-wood-small-BL">
                    <Size x="17" y="23" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.RightBorder"
                            relativePoint="BOTTOM" x="2" y="1" />
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="-1">
                <Texture parentKey="RightBorderBackground" atlas="catalog-nav-bg-secondary">
                    <Size x="34" />
                    <Anchors>
                        <Anchor point="TOP" relativeKey="$parent.RightBorder" />
                        <Anchor point="BOTTOM" relativeKey="$parent.RightBorder" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
        </Scripts>
    </Frame>

    <Frame name="SimscraftShoppingListManagerFrame" parent="UIParent"
        inherits="PortraitFrameFlatTemplate" mixin="SimscraftShoppingListManagerFrameMixin">
        <Size x="750" y="600" />
        <Anchors>
            <Anchor point="CENTER" />
        </Anchors>

        <Frames>
            <Frame parentKey="ListFrame" inherits="SimscraftShoppingListManagerListFrameTemplate">
                <Size x="250" />
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-23" />
                    <Anchor point="BOTTOMLEFT" x="5" y="3" />
                </Anchors>
            </Frame>
            <Frame parentKey="DisplayFrame" inherits="SimscraftShoppingListDisplayTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT" y="-23"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.ListFrame" relativePoint="BOTTOMRIGHT" x="5"/>
                </Anchors>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>

</Ui>