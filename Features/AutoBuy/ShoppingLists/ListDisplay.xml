<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

    <Include file="ListDisplay.lua" />

    <Frame name="SimscraftShoppingListDisplayTemplate" virtual="true" mixin="SimscraftShoppingListDisplayMixin" clipChildren="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" atlas="housing-basic-panel--stone-background" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="MetadataContainer" inherits="VerticalLayoutFrame">
                <Size y="150"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="5"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
                <KeyValues>
                    <KeyValue key="expand" value="false" type="boolean" />
                </KeyValues>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="Title" font="GameFontWhite">
                            <KeyValues>
                                <KeyValue key="layoutIndex" value="1" type="number" />
                            </KeyValues>
                        </FontString>
                        <FontString parentKey="LastEditedAt" font="GameFontWhite">
                            <KeyValues>
                                <KeyValue key="layoutIndex" value="2" type="number" />
                            </KeyValues>
                        </FontString>
                        <FontString parentKey="Size" font="GameFontWhite">
                            <KeyValues>
                                <KeyValue key="layoutIndex" value="3" type="number" />
                            </KeyValues>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
        </Scripts>
    </Frame>
</Ui>