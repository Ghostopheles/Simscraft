<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

    <Include file="Events.lua"/>
    <Include file="CartEntry.lua"/>
    <Include file="Cart.lua"/>

    <Button name="SimscraftClearCartButtonTemplate" inherits="UIButtonTemplate" virtual="true">
        <Size x="40" y="40"/>
        <KeyValues>
            <KeyValue key="buttonArtKit" value="128-RedButton-Delete" type="string" />
        </KeyValues>
    </Button>

    <Button name="SimscraftToggleCartButtonTemplate" inherits="UIButtonTemplate" virtual="true">
        <Size x="24" y="24"/>
        <KeyValues>
            <KeyValue key="buttonArtKit" value="128-RedButton-ShoppingCart" type="string" />
        </KeyValues>
    </Button>

    <ItemButton name="SimscraftShoppingCartEntryItemButtonTemplate" mixin="SimscraftShoppingCartEntryItemButtonMixin" virtual="true">
        <Scripts>
            <OnUpdate method="OnUpdate"/>
            <OnClick method="OnClick"/>
        </Scripts>
    </ItemButton>

    <Frame name="SimscraftShoppingCartEntryTemplate" mixin="ShoppingCartEntryMixin" virtual="true">
        <Size y="25" />
        <Frames>
            <ItemButton parentKey="ItemButton" scale="0.75" inherits="SimscraftShoppingCartEntryItemButtonTemplate">
                <Anchors>
                    <Anchor point="LEFT" x="5" />
                </Anchors>
            </ItemButton>
            <EditBox parentKey="QuantityEditBox" inherits="InputBoxTemplate" autoFocus="false"
                numeric="true">
                <Size x="40" y="25" />
                <Anchors>
                    <Anchor point="RIGHT" x="-75" y="1" />
                </Anchors>
            </EditBox>
            <Button parentKey="RemoveButton" inherits="UIPanelCloseButtonNoScripts">
                <Size x="20" y="20" />
                <Anchors>
                    <Anchor point="RIGHT" />
                </Anchors>
            </Button>
        </Frames>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="ItemLabel" inherits="GameFontWhite" justifyH="LEFT"
                    justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.ItemButton" relativePoint="RIGHT"
                            x="5" />
                        <Anchor point="RIGHT" relativeKey="$parent.QuantityEditBox"
                            relativePoint="LEFT" x="-10" />
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemCost" inherits="GameFontWhite" justifyH="RIGHT"
                    justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="RIGHT" relativeKey="$parent.RemoveButton" relativePoint="LEFT"
                            x="-4" />
                        <Anchor point="LEFT" relativeKey="$parent.QuantityEditBox"
                            relativePoint="RIGHT" />
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>

    <StatusBar name="SimscraftPurchaseOverlayProgressBarTemplate" mixin="SmoothStatusBarMixin" frameBuffer="true" virtual="true">
        <Size x="275" y="15"/>
        <BarTexture parentKey="BarFill" atlas="housing-dashboard-fillbar-fill"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="BarBackground" atlas="housing-dashboard-fillbar-bar-bg" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="PurchasingText" justifyH="CENTER" justifyV="MIDDLE" inherits="GameFontWhite">
                    <Anchors>
                        <Anchor point="BOTTOM" relativePoint="TOP" y="5"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ProgressText" justifyH="CENTER" justifyV="MIDDLE" inherits="GameFontWhite">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </StatusBar>

    <Include file="CartFrame.lua"/>
    <Include file="AutoBuy.lua" />
</Ui>